# ==============================================================================
# Configurações de Ambiente - Equipe de Marketing Digital (CrewAI)
# Copie este arquivo para '.env' e preencha com suas configurações locais:
#   cp .env.example .env
# ==============================================================================

# Chave de API do Google Gemini (utilizada pelo agente Media Buyer)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# Tracing e Telemetria do CrewAI (opcional: true | false)
CREWAI_TRACING_ENABLED=false
